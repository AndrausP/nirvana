{
  "name": "learning-agent",
  "description": "THE ASCENSION PROTOCOL — active agent memory, token optimization, living project codex. Skills: /invoke /inscribe /gaze /obliterate /forge /chronicle",
  "author": {
    "name": "Andraus Felipe Ribeiro"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10,
            "statusMessage": "Loading agent memories..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.js\"",
            "timeout": 5,
            "statusMessage": "Checking model routing..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.js\"",
            "timeout": 5,
            "statusMessage": "Checking task completion..."
          }
        ]
      }
    ]
  }
}
