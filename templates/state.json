{
  "nirvana": "2.1.0",
  "sync": {
    "every": 5,
    "lastSync": null
  },
  "compact": {
    "auto": true,
    "threshold": 70
  },
  "preferences": {
    "caveman": "full",
    "language": "auto",
    "chainVisibility": "hidden",
    "entryBanner": true
  },
  "project": {
    "type": "{{PROJECT_TYPE}}",
    "stack": ["{{STACK}}"],
    "docsPath": "docs/"
  },
  "graphify": {
    "enabled": true,
    "source": "docs/knowledge",
    "outPath": "graphify-out/",
    "owner": "writer",
    "lastIndexed": null
  },
  "agents": {
    "productOwner": {
      "active": true,
      "model": "opus"
    },
    "techLead": {
      "active": true,
      "model": "opus"
    },
    "architect": {
      "active": true,
      "model": "sonnet",
      "specialty": "{{BACKEND_SPECIALTY}} + {{FRONTEND_SPECIALTY}}"
    },
    "devBackend": {
      "active": true,
      "model": "sonnet",
      "specialty": "{{BACKEND_SPECIALTY}}"
    },
    "devFrontend": {
      "active": true,
      "model": "sonnet",
      "specialty": "{{FRONTEND_SPECIALTY}}"
    },
    "designer": {
      "active": true,
      "model": "sonnet"
    },
    "qa": {
      "active": true,
      "model": "sonnet",
      "specialty": "{{QA_SPECIALTY}}"
    },
    "reader": {
      "active": true,
      "model": "haiku"
    },
    "writer": {
      "active": true,
      "model": "sonnet"
    }
  },
  "tasks": {
    "bigtaskAutoGrill": true,
    "smalltaskAutoExecute": true,
    "tasksPath": "docs/tasks/",
    "sprintsPath": "docs/sprints/"
  }
}
