{
  "nirvana": "2.0.0",
  "sync": {
    "every": 1,
    "sessionCount": 0,
    "lastSync": null
  },
  "compact": {
    "auto": true,
    "threshold": 70
  },
  "preferences": {
    "caveman": "full",
    "language": "auto",
    "chainVisibility": "hidden",
    "entryBanner": true
  },
  "project": {
    "type": "library",
    "stack": ["markdown-skills", "powershell-installer", "bash-installer"],
    "docsPath": "docs/"
  },
  "graphify": {
    "enabled": true,
    "source": "docs/knowledge",
    "outPath": "graphify-out/",
    "owner": "writer",
    "lastIndexed": null
  },
  "agents": {
    "productOwner": {
      "active": true,
      "model": "opus"
    },
    "techLead": {
      "active": true,
      "model": "opus"
    },
    "architect": {
      "active": true,
      "model": "sonnet",
      "specialty": "N/A (framework repo)"
    },
    "devBackend": {
      "active": true,
      "model": "sonnet",
      "specialty": "N/A (framework repo)"
    },
    "devFrontend": {
      "active": true,
      "model": "sonnet",
      "specialty": "N/A (framework repo)"
    },
    "designer": {
      "active": true,
      "model": "sonnet"
    },
    "qa": {
      "active": true,
      "model": "sonnet",
      "specialty": "Manual dogfood validation"
    },
    "reader": {
      "active": true,
      "model": "haiku"
    },
    "writer": {
      "active": true,
      "model": "sonnet"
    }
  },
  "tasks": {
    "bigtaskAutoGrill": true,
    "smalltaskAutoExecute": true,
    "tasksPath": "docs/tasks/",
    "sprintsPath": "docs/sprints/"
  }
}
